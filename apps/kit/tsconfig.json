{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/highlight/*": ["../../packages/registry/src/highlight/*"],
      "@/components/quote/*": ["../../packages/registry/src/quote/*"],
      "@/components/blocks/*": ["../../packages/registry/src/blocks/*"],
      "@/components/ui/anchored-panel": ["../../packages/registry/src/ui/anchored-panel"],
      "@/components/ui/canvas": ["../../packages/registry/src/ui/canvas"],
      "@/components/ui/color-field": ["../../packages/registry/src/ui/color-field"],
      "@/components/ui/color-picker": ["../../packages/registry/src/ui/color-picker"],
      "@/components/ui/inline-edit-field": ["../../packages/registry/src/ui/inline-edit-field"],
      "@/components/ui/marker-rail": ["../../packages/registry/src/ui/marker-rail"],
      "@/components/ui/side-panel": ["../../packages/registry/src/ui/side-panel"],
      "@/components/ui/snap-carousel": ["../../packages/registry/src/ui/snap-carousel"],
      "@/components/ui/swatch": ["../../packages/registry/src/ui/swatch"],
      "@/components/ui/*": ["../../apps/site/src/components/ui/*"],
      "@/hooks/use-anchored-panel": ["../../packages/registry/src/hooks/use-anchored-panel"],
      "@/hooks/use-reduced-motion": ["../../packages/registry/src/hooks/use-reduced-motion"],
      "@/hooks/use-text-selection": ["../../packages/registry/src/hooks/use-text-selection"],
      "@/lib/highlight-anchor": ["../../packages/registry/src/lib/highlight-anchor"],
      "@/lib/highlight-palette": ["../../packages/registry/src/lib/highlight-palette"],
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
