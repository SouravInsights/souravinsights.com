{
  "name": "souravinsights",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:site": "turbo run dev --filter=site",
    "dev:kit": "turbo run dev --filter=kit",
    "build": "turbo run build",
    "build:site": "turbo run build --filter=site",
    "build:kit": "turbo run build --filter=kit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck",
    "registry:build": "cd packages/registry && npx shadcn@latest build && rm -rf ../../apps/kit/public/r && cp -R public/r ../../apps/kit/public/r"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.5.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@sparticuz/chromium",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ]
}
