{
  "name": "souravinsights",
  "private": true,
  "version": "0.1.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "kit/react",
      "kit/react-dom",
      "kit/@types/react",
      "kit/@types/react-dom",
      "site/react",
      "site/react-dom",
      "site/@types/react",
      "site/@types/react-dom"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:site": "turbo run dev --filter=site",
    "build": "turbo run build",
    "build:site": "turbo run build --filter=site",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "registry:build": "cd packages/registry && npx shadcn@latest build && rm -rf ../../apps/kit/public/r && cp -R public/r ../../apps/kit/public/r"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "yarn@1.22.21"
}
