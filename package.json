{
  "name": "souravinsights",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:site": "turbo run dev --filter=site",
    "build": "turbo run build",
    "build:site": "turbo run build --filter=site",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "yarn@1.22.21"
}
