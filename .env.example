# Copy to .env.local and fill in what you need.
#
# Only the first three groups are required to run the site and its knowledge
# base. Everything marked optional belongs to other pages and can stay empty.

# --- Required -------------------------------------------------------------

# Postgres with the pgvector extension. This project uses Neon.
# The migration config reads .env, so keep DATABASE_URL there as well as here.
DATABASE_URL=

# Embeddings and the agent. Any OpenRouter key works: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Rate limits, caches and like counts. Any Upstash Redis works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gates the admin endpoints (?admin on the Insights page) and the Writing Desk.
ADMIN_SECRET=

# --- The links intake -----------------------------------------------------

# Reading the Discord channel the links are posted to.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# The same Redis, under the names the Trigger.dev task uses.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Canonical URLs, and the secret the intake uses to revalidate the page.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# --- Analytics ------------------------------------------------------------

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Optional: other pages ------------------------------------------------

# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# READWISE_API_TOKEN=
# WEATHERAPI_KEY=
# WEATHER_CITY=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# CHROME_PATH=

# Moves the retrieval eval's "not covered" line. See scripts/kb-eval.ts.
# KB_CUTOFF=0.35
